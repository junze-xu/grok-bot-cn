{
  "name": "@junze-xu/grokbot",
  "version": "1.1.0",
  "description": "Grok Bot 模板工程化工具包 — 规格说明、团队、技能、例行程序，以及一套可直接粘贴到 Grok Bot 的目录。",
  "type": "module",
  "bin": {
    "grokbot": "bin/grokbot.mjs"
  },
  "files": [
    "bin",
    "lib",
    "schema",
    "templates",
    "teams",
    "skills",
    "routines",
    "patterns",
    "convert",
    "START.md",
    "SPEC.md",
    "catalog/catalog.json",
    "catalog/share-links.json",
    "assets/*.jpg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "grokbot": "node bin/grokbot.mjs",
    "render": "node scripts/render.mjs",
    "catalog": "node scripts/build-catalog.mjs && node scripts/build-start.mjs",
    "counts": "node scripts/build-counts.mjs",
    "site": "node scripts/build-counts.mjs && node scripts/build-site.mjs",
    "lint": "node bin/grokbot.mjs validate",
    "validate": "node bin/grokbot.mjs validate",
    "doctor": "node bin/grokbot.mjs doctor",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run render && npm run catalog && npm run site",
    "ci": "npm run build && npm run validate && npm test && npm run doctor",
    "prepublishOnly": "npm run ci"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "grok",
    "grok-bot",
    "xai",
    "templates",
    "agents",
    "skills",
    "routines",
    "cli"
  ],
  "author": "junze-xu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/junze-xu/grok-bot-cn.git"
  },
  "homepage": "https://junze-xu.github.io/grok-bot-cn/",
  "bugs": {
    "url": "https://github.com/junze-xu/grok-bot-cn/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "yaml": "^2.9.1"
  }
}
